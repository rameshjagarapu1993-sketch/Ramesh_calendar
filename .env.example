# URL of the booking backend (Google Apps Script web app). See backend/SETUP.md.
# Without it the site runs in DEMO mode: no real Meet room or calendar invite is created.
VITE_BOOKING_API_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional: server-side email sending used by /api/send-email (server.ts locally, api/send-email.ts on Vercel).
# Only needed in demo mode; in live mode the Apps Script backend sends all emails.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
